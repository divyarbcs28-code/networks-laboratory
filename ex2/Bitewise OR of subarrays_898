unsigned int hash(int x, unsigned int size) {
    unsigned int h = (unsigned int)x;
    h ^= h >> 16;
    h *= 0x7feb352d;
    h ^= h >> 15;
    return h & (size - 1);
}

int insert(int* table, unsigned int size, int value) {
    unsigned int index = hash(value, size);

    while (table[index] != HASH_EMPTY) {
        if (table[index] == value)
            return 0;  // already exists

        index = (index + 1) & (size - 1);
    }

    table[index] = value;
    return 1;  // newly inserted
}

int subarrayBitwiseORs(int* arr, int arrSize) {
    /*
     * At most about 32 different OR values can exist
     * for subarrays ending at each position.
     */
    int cur[32];
    int next[32];

    int curSize = 0;
    int answer = 0;

    /*
     * Maximum number of distinct results is roughly 32 * n.
     * Use a power of 2 for the hash table.
     */
    unsigned int capacity = 1;

    while (capacity < (unsigned int)(arrSize * 64 + 1)) {
        capacity <<= 1;
    }

    int* table = malloc(sizeof(int) * capacity);

    for (unsigned int i = 0; i < capacity; i++) {
        table[i] = HASH_EMPTY;
    }

    for (int i = 0; i < arrSize; i++) {
        int x = arr[i];
        int nextSize = 0;

        // Subarray [x]
        next[nextSize++] = x;

        // Extend all previous subarrays
        for (int j = 0; j < curSize; j++) {
            int val = cur[j] | x;

            // OR values are non-decreasing,
            // so duplicates occur next to each other.
            if (next[nextSize - 1] != val) {
                next[nextSize++] = val;
            }
        }

        // Move next -> cur
        for (int j = 0; j < nextSize; j++) {
            cur[j] = next[j];

            if (insert(table, capacity, cur[j])) {
                answer++;
            }
        }

        curSize = nextSize;
    }

    free(table);

    return answer;
}
